# Postgres connection string. On Vercel this is filled in automatically
# when you add a Neon (or Supabase) database from the Storage tab.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bjj

# The password coaches type to log in to the app.
APP_PASSWORD=change-me

# Optional: time zone used to decide what "today" is.
CLUB_TIMEZONE=Europe/Sarajevo
